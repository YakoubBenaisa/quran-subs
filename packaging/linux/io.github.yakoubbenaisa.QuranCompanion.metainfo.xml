<component type="desktop-application">
  <id>io.github.yakoubbenaisa.QuranCompanion</id>
  <name>Quran Companion</name>
  <name xml:lang="ar">رفيق التلاوة</name>
  <summary>Quran verses on your screen while you work</summary>
  <summary xml:lang="ar">آيات القرآن على شاشتك أثناء عملك</summary>
  <developer id="io.github.yakoubbenaisa">
    <name>Yakoub Benaisa</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <!-- TODO before publishing: the license you choose for the code, e.g. GPL-3.0-or-later or MIT -->
  <project_license>LicenseRef-TODO</project_license>
  <description>
    <p>
      A reciter plays and the verse being recited appears over your windows like subtitles, with its
      translation. The text never takes focus and clicks pass through it, so you keep working underneath.
    </p>
    <ul>
      <li>115 reciters with verse timings, page turns on the exact word for many of them</li>
      <li>Memorize mode: silent, at your pace, with hints that reveal or hide the verse</li>
      <li>Recitations from YouTube, MP3 links or your own files, synced to the verses automatically</li>
      <li>Follow a recitation video playing in Firefox or Chrome</li>
      <li>Translations in many languages, Arabic and English interface, light and dark themes</li>
      <li>Global keyboard shortcuts and offline downloads</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.yakoubbenaisa.QuranCompanion.desktop</launchable>
